MONGODB_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/juicebar?retryWrites=true&w=majority
MONGODB_DB=juicebar
PORT=3000
# Used ONLY to create the very first owner account, the first time the
# server ever runs against an empty database. After that first login,
# change this password from the Staff tab — these values are ignored
# once an owner account already exists.
OWNER_USERNAME=owner
OWNER_PASSWORD=changeme123
